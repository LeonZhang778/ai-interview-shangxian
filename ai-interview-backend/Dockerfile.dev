FROM python:3.12-slim

WORKDIR /app

# 全局环境变量
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 构建代理参数（构建时传入，运行时不残留）
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""

# 1. 替换Debian国内源（必须放在apt操作最前面）
RUN sed -i 's|mirrors.aliyun.com|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|mirrors.aliyun.com|mirrors.aliyun.com|g' /etc/apt/sources.list

# 2. 安装系统依赖（新增apt缓存挂载，重复构建速度提升显著）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    pkg-config \
    libpq-dev \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# 3. 配置pip国内源
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ && \
    pip config set global.trusted-host mirrors.aliyun.com

# 4. 安装Python依赖（缓存挂载保留，避免重复下载）
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r requirements.txt

# 5. 复制项目代码
COPY . .

# 6. 初始化目录、配置非root用户
RUN mkdir -p logs uploads/resumes && \
    useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app
USER app

# 暴露端口（仅主应用需要，celery服务可继承不影响）
EXPOSE 8006

# 健康检查（仅主应用生效，celery服务会自动忽略，不影响构建）
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD sh -c "ffmpeg -version >/dev/null 2>&1 && ffprobe -version >/dev/null 2>&1 && curl -f http://localhost:8006/api/v1/config/health" || exit 1

# 启动命令：在docker-compose中为不同服务单独覆盖，这里保留默认值
CMD ["python", "main.py"]