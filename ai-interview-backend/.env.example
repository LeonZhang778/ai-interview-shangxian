# 环境配置
ENV=development
PROJECT_NAME=AI-Interview
API_V1_STR=/api/v1
API_PORT=8006

# 数据库配置
POSTGRES_USER=demo
POSTGRES_PASSWORD=<本地开发数据库密码>
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ai_interview

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=<本地开发 Redis 密码>
REDIS_CHECKPOINT_DB=0
LANGGRAPH_CHECKPOINT_TTL_MINUTES=180

# HTTP 代理配置（一般不需要开启）
USE_HTTP_PROXY=false
HTTP_PROXY=
HTTPS_PROXY=

# 邮件配置（请通过本机 `.env` 注入真实凭据）
MAIL_MAILER=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=<QQ 邮箱地址>
MAIL_PASSWORD=<QQ 邮箱授权码，不要提交到 Git>
MAIL_FROM_ADDRESS=<发件邮箱地址>
MAIL_FROM_NAME=AI-Interview
MAIL_ENCRYPTION=ssl

# Brevo 邮件服务（未启用时保持占位符）
BREVO_API_KEY=<Brevo API Key，不要提交到 Git>
BREVO_EMAIL_FROM=<发件邮箱地址>
BREVO_EMAIL_FROM_NAME=AI-Interview

# 管理员邮箱
ADMIN_EMAIL=<管理员邮箱地址>

# JWT 配置
SECRET_KEY=<本地开发 JWT 密钥>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 配置（当前未启用，使用本地存储）
AWS_ACCESS_KEY_ID=<AWS Access Key，不要提交到 Git>
AWS_SECRET_ACCESS_KEY=<AWS Secret Key，不要提交到 Git>
AWS_REGION=us-east-1
AWS_BUCKET_NAME=<S3 Bucket 名称>
AWS_ENDPOINT=https://s3.amazonaws.com

# OpenAI 配置（当前未使用）
OPENAI_API_KEY=<OpenAI API Key，不要提交到 Git>

# Grok 中转站 AI 配置（必填）
# 优先读取 XAI_API_KEY / GROK_MODELS_BASE_URL；AI_* 保留兼容旧部署
XAI_API_KEY=<Grok 中转站 API Key，不要提交到 Git>
GROK_MODELS_BASE_URL=https://sub.anzhiyu.com/v1
GROK_MODEL=grok-4.3
AI_API_KEY=<Grok 中转站 API Key，不要提交到 Git>
AI_BASE_URL=https://sub.anzhiyu.com/v1
AI_MODEL=grok-4.3

# 千问 DashScope AI 配置（必填）：供简历解析 / 模拟面试（出题、评分、报告）使用
# 申请：https://help.aliyun.com/zh/model-studio/first-api-call-to-qwen
# 推荐：qwen-plus（非推理、快、JSON 稳）；qwen3.8-max 质量更好但带推理链、延迟高
AI_QWEN_API_KEY=<通义千问 API Key，不要提交到 Git>
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_QWEN_MODEL=qwen-plus

# 图片生成服务配置
POLLINATIONS_API_KEY=<图片生成服务 API Key，不要提交到 Git>
