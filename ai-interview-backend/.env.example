# 环境配置
ENV=development
PROJECT_NAME=AI-Interview
API_V1_STR=/api/v1
API_PORT=8006

# 数据库配置
POSTGRES_USER=demo
POSTGRES_PASSWORD=<本地开发数据库密码>
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ai_interview

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<本地开发 Redis 密码>
REDIS_CHECKPOINT_DB=0
LANGGRAPH_CHECKPOINT_TTL_MINUTES=180

# HTTP 代理配置（一般不需要开启）
USE_HTTP_PROXY=false
HTTP_PROXY=
HTTPS_PROXY=

# 邮件配置（请通过本机 `.env` 注入真实凭据）
MAIL_MAILER=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=<QQ 邮箱地址>
MAIL_PASSWORD=<QQ 邮箱授权码，不要提交到 Git>
MAIL_FROM_ADDRESS=<发件邮箱地址>
MAIL_FROM_NAME=AI-Interview
MAIL_ENCRYPTION=ssl

# Brevo 邮件服务（未启用时保持占位符）
BREVO_API_KEY=<Brevo API Key，不要提交到 Git>
BREVO_EMAIL_FROM=<发件邮箱地址>
BREVO_EMAIL_FROM_NAME=AI-Interview

# 管理员邮箱
ADMIN_EMAIL=<管理员邮箱地址>

# JWT 配置
SECRET_KEY=<本地开发 JWT 密钥>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 配置（当前未启用，使用本地存储）
AWS_ACCESS_KEY_ID=<AWS Access Key，不要提交到 Git>
AWS_SECRET_ACCESS_KEY=<AWS Secret Key，不要提交到 Git>
AWS_REGION=us-east-1
AWS_BUCKET_NAME=<S3 Bucket 名称>
AWS_ENDPOINT=https://s3.amazonaws.com

# OpenAI 配置（当前未使用）
OPENAI_API_KEY=<OpenAI API Key，不要提交到 Git>

# DeepSeek AI 配置（必填）：简历解析 / 模拟面试（出题、评分、报告）全部走默认通道
# 申请：https://platform.deepseek.com/api_keys
# deepseek-flash 支持 image 输入，可直接作为 AI_VISION_MODEL 复用（另需 AI_OCR_ENABLED=True）
AI_API_KEY=<DeepSeek API Key，不要提交到 Git>
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_MODEL_FALLBACK=
AI_VISION_MODEL=deepseek-flash

# 历史千问 DashScope 通道（已停用）：保持 AI_QWEN_API_KEY 为空，
# provider="qwen" 的历史调用会自动回落默认通道（DeepSeek）
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_QWEN_MODEL=qwen-plus

# 历史 Grok 中转站配置（已停用，保留键名兼容旧部署）
XAI_API_KEY=
GROK_MODELS_BASE_URL=
GROK_MODEL=grok-4.3

# 图片生成服务配置
POLLINATIONS_API_KEY=<图片生成服务 API Key，不要提交到 Git>
