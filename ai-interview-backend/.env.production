# ============================================
# AI-Interview 生产环境配置模板
# 使用方法: 复制此文件为 .env.production, 替换 {{占位符}} 为实际值
# ============================================

# 环境配置
ENV=production
PROJECT_NAME=AI-Interview
API_V1_STR=/api/v1
API_PORT=8001

# 前端地址 (替换为你的域名, 用于邮件验证链接和 CORS)
FRONTEND_URL=https://{{你的域名}}

# 数据库配置 (Docker 内部通信使用服务名)
POSTGRES_USER={{自定义用户名}}
POSTGRES_PASSWORD={{随机强密码}}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_interview

# Redis 配置 (Docker 内部通信使用服务名, 生产环境必须设置密码)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{随机强密码}}

# HTTP 代理配置 (生产环境关闭)
USE_HTTP_PROXY=false
HTTP_PROXY=
HTTPS_PROXY=

# 邮件配置 (QQ 邮箱)
# 授权码获取: QQ邮箱 -> 设置 -> 账户 -> POP3/IMAP/SMTP服务 -> 开启SMTP -> 生成授权码
MAIL_MAILER=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME={{你的QQ邮箱}}
MAIL_PASSWORD={{QQ邮箱授权码}}
MAIL_FROM_ADDRESS={{你的QQ邮箱}}
MAIL_FROM_NAME=AI-Interview
MAIL_ENCRYPTION=ssl

# JWT 配置 (使用 openssl rand -hex 32 生成)
SECRET_KEY={{随机32位字符串}}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI 配置 (智谱 GLM)
AI_API_KEY={{你的智谱API Key}}
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.7-flash

# 管理员邮箱
ADMIN_EMAIL={{你的邮箱}}

# ============================================
# 生成随机密钥的命令:
# openssl rand -hex 32      (生成 SECRET_KEY)
# openssl rand -base64 16   (生成数据库/Redis密码)
# ============================================
