MAIL_MAILER=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=1448203623@qq.com
MAIL_PASSWORD=qxxbeqhanjsbjcga
MAIL_FROM_ADDRESS=1448203623@qq.com
MAIL_FROM_NAME=AI-Interview
MAIL_ENCRYPTION=ssl

# Brevo 邮件服务（当前未启用）
