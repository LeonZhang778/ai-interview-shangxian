# ===== AI-Interview 项目 .gitignore =====

# ---------- 学习/笔记文件 ----------
memory.md
ai-interview学习记录/
ai-interview学习记录.md
Python后端实习-项目学习流程.md
ai-interview-script-md-pdf/
txt.txt
命令文件.md

# ---------- 启动/停止脚本 ----------
start.ps1
stop.ps1
启动.bat
停止.bat

# ---------- IDE ----------
.vscode/
.idea/
.codepus/
.codepus-todos.json

.codepus.json

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---------- Node.js ----------
node_modules/

# ---------- 测试产物 ----------
ai-interview-frontend/test-results/

# ---------- 环境配置 ----------
.env
.env.*
!.env.example



# ---------- 后端运行时 ----------
logs/
ai-interview-backend/logs/
ai-interview-backend/__pycache__/
ai-interview-backend/celerybeat-schedule.db/

# ---------- 本地 PostgreSQL 数据目录 ----------
.local-postgres/

# ---------- 上传文件 ----------
ai-interview-backend/uploads/avatars/*
ai-interview-backend/uploads/resumes/*
ai-interview-backend/uploads/media/*
!ai-interview-backend/uploads/avatars/.gitkeep
!ai-interview-backend/uploads/resumes/.gitkeep
!ai-interview-backend/uploads/media/.gitkeep

# ---------- Docker 大文件 ----------
ai-interview-backend/docker-compose-linux-x86_64

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db

# ---------- 调试/临时脚本 ----------
debug_*.py
check_*.py
# 例外：scripts/ 下的检查脚本是正式门禁，必须入库（CI 依赖）
!ai-interview-backend/scripts/check_*.py
run_debug.py
deploy_fix.py
rebuild_deploy.py
test_api_script.py
test_bug_fixes.py
test_delete_experience.py
test_interaction.py
test_new_features.py
test_new_features_result.png
test_notification_e2e.py
test_admin_features.py
test_admin_*.png
screenshot_*.png
full_page_*.png
admin_experiences*.png
test_*.png

# ---------- 测试媒体文件 ----------
ai-interview-backend/test_media*.mp4
ai-interview-backend/test_media*.mp3
ai-interview-backend/test_media_converted*
ai-interview-backend/media_test_*

# ---------- 其他 ----------
*.log
*.bak
*.tmp
*.stackdump
/test_resume.pdf
ai-interview-backend/evaluation/interview_eval_history.jsonl

# 本地工作记录（项目记忆/日志），不入库
.workbuddy/
# 备份与二进制 dump 不入库
ai-interview-backend/backups/
*.dump
*.rdb

# CI/本地的前端构建校验产物（不改动被 Git 跟踪的 dist/）
.ci-build-check/
